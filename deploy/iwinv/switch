#!/bin/bash
# 무중단 교체(blue/green) — 모든 서비스(/home/ubuntu/web/<서비스>)가 같이 쓴다. 2026-11-17
#
#   /opt/webdeploy/switch <서비스> <prod|dev> <태그>        (관문 gate 가 부르고, 손으로 되돌릴 때도 같은 명령)
#   태그 목록: docker images web-<서비스>
#
# 환경마다 컨테이너 자리가 둘이다: web-<서비스>-<env>-blue / -green(compose 서비스 <env>-blue / <env>-green).
# 둘 다 네트워크 별칭 web-<서비스>-<env> 를 가져서, 안쪽에서 그 이름으로 부르는 쪽은 바뀌는 것이 없다.
#
# 순서 — 지금 돌고 있는 컨테이너는 끝까지 건드리지 않다가 마지막에 멈춘다.
#   1. 비어 있는 자리에 새 태그로 띄운다
#   2. 헬스 확인(이미지에 HEALTHCHECK 가 있으면 healthy, 없으면 3000 포트 응답). 실패하면 새 것만 멈추고 끝 — 서비스는 그대로
#   3. 바깥 길: /opt/edge/sites/*.caddy 에서 이 서비스를 가리키는 주소를 새 컨테이너 이름으로 바꾸고 Caddy 를 무중단으로 다시 읽는다
#      (설정이 틀리면 Caddy 가 거부 → 파일을 되돌리고 새 것만 멈춘다)
#   4. 옛 컨테이너에 남은 연결이 다 끝날 때까지 기다렸다가(최대 DRAIN_MAX 초, 기본 120) 멈춘다 — 지우지 않는다(바로 되돌리기용)
# 현재 자리와 태그는 같은 폴더 .env: <ENV>_COLOR, <ENV>_TAG_BLUE, <ENV>_TAG_GREEN, (선택) DRAIN_MAX
set -euo pipefail
SVC="$1" ENVN="$2" TAG="$3"
BASE="/home/ubuntu/web/$SVC"; IMG="web-$SVC"; NAME="web-$SVC-$ENVN"
E="$(echo "$ENVN" | tr a-z A-Z)"
SITES=/opt/edge/sites
[[ "$SVC" =~ ^[a-z0-9-]+$ && "$ENVN" =~ ^(prod|dev)$ ]] || { echo "bad args" >&2; exit 2; }
docker image inspect "$IMG:$TAG" >/dev/null
cd "$BASE"
exec 9>"$BASE/.switch.lock"; flock 9
touch .env
getv() { sed -n "s/^$1=//p" .env | tail -1; }
setv() { grep -v "^$1=" .env > .env.new || true; echo "$1=$2" >> .env.new; mv .env.new .env; }
log() { echo "[switch $NAME] $*"; }

CUR="$(getv "${E}_COLOR")"                     # blue | green | 비어 있음(예전 단일 컨테이너)
NEW=blue; [[ "$CUR" == blue ]] && NEW=green
NEWU="$(echo "$NEW" | tr a-z A-Z)"
NC="$NAME-$NEW"
OLD=""; [[ -n "$CUR" ]] && OLD="$NAME-$CUR"
[[ -z "$CUR" ]] && docker inspect "$NAME" >/dev/null 2>&1 && OLD="$NAME"   # 첫 전환: 예전 단일 컨테이너
PREV_TAG="$(getv "${E}_TAG_$NEWU")"

# 1. 새 자리 띄우기
setv "${E}_TAG_$NEWU" "$TAG"
log "starting $NC ($TAG)"
docker compose up -d --no-deps "$ENVN-$NEW"

# 2. 헬스
health() {
  local c="$1" st
  for _ in $(seq 1 90); do
    if [[ -n "$(docker inspect -f '{{if .State.Health}}y{{end}}' "$c")" ]]; then
      st="$(docker inspect -f '{{.State.Health.Status}}' "$c")"
      [[ "$st" == healthy ]] && return 0
      [[ "$st" == unhealthy ]] && return 1
    elif docker exec "$c" node -e "fetch('http://127.0.0.1:3000/',{redirect:'manual'}).then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))" 2>/dev/null; then
      return 0
    fi
    # 꺼졌거나, 꺼졌다 다시 켜지는 중(재시작 정책)이면 바로 실패로 본다
    [[ "$(docker inspect -f '{{.State.Running}} {{.RestartCount}}' "$c")" == "true 0" ]] || return 1
    sleep 2
  done
  return 1
}
abort() {
  echo "[switch $NAME] $1 — 지금 서비스(${OLD:-없음})는 그대로 둔다" >&2
  docker logs --tail 60 "$NC" >&2 || true
  docker compose stop -t 10 "$ENVN-$NEW" >/dev/null 2>&1 || true
  if [[ -n "$PREV_TAG" ]]; then setv "${E}_TAG_$NEWU" "$PREV_TAG"; else grep -v "^${E}_TAG_$NEWU=" .env > .env.new || true; mv .env.new .env; fi
  exit 1
}
health "$NC" || abort "health check failed for $NC ($TAG)"

# 3. 바깥 길(Caddy) 바꾸기
mapfile -t FILES < <(grep -lE "(^|[^a-z0-9-])$NAME(-blue|-green)?:[0-9]+" "$SITES"/*.caddy 2>/dev/null || true)
if (( ${#FILES[@]} )); then
  BAK="$(mktemp -d)"
  for f in "${FILES[@]}"; do cp -p "$f" "$BAK/"; sed -i -E "s/(^|[^a-z0-9-])$NAME(-blue|-green)?:([0-9]+)/\1$NC:\3/g" "$f"; done
  if ! docker exec edge-caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>"$BAK/err"; then
    cat "$BAK/err" >&2
    for f in "${FILES[@]}"; do cp -p "$BAK/$(basename "$f")" "$f"; done
    rm -rf "$BAK"
    abort "caddy reload failed"
  fi
  rm -rf "$BAK"
  log "caddy now → $NC"
fi
setv "${E}_COLOR" "$NEW"

# 4. 옛 컨테이너: 남은 연결이 끝나면 멈춘다
if [[ -n "$OLD" ]] && [[ "$(docker inspect -f '{{.State.Running}}' "$OLD" 2>/dev/null)" == true ]]; then
  PORT="$(docker inspect -f '{{range $p, $_ := .Config.ExposedPorts}}{{$p}} {{end}}' "$OLD" | grep -oE '^[0-9]+' || true)"
  HEX="$(printf '%04X' "${PORT:-0}")"
  MAX="$(getv DRAIN_MAX)"; MAX="${MAX:-120}"
  sleep 5   # Caddy 가 새 설정으로 넘어가며 옛 연결을 정리할 시간
  zero=0
  for ((i = 0; i < MAX; i++)); do
    # 컨테이너의 /proc/net/tcp(6) 에서 서비스 포트로 들어온 연결(ESTABLISHED=01) 수 — 두 번 연속 0 이면 멈춘다
    n="$(docker exec "$OLD" sh -c "cat /proc/net/tcp /proc/net/tcp6 2>/dev/null" 2>/dev/null \
      | awk -v p=":$HEX" '$2 ~ p"$" && $4 == "01"' | wc -l || echo 0)"
    if [[ -z "$n" || "$n" == 0 ]]; then zero=$((zero + 1)); else zero=0; fi   # 셀 수 없는 이미지는 0 으로 본다
    (( zero >= 2 )) && break
    sleep 1
  done
  log "draining done after $((i + 5))s, stopping $OLD"
  docker stop -t 30 "$OLD" >/dev/null
  # 예전 단일 컨테이너(compose 의 옛 서비스)는 자리가 없으니 지운다. blue/green 은 멈춰만 둔다.
  [[ "$OLD" == "$NAME" ]] && docker rm "$OLD" >/dev/null
fi

# 태그 정리: 두 자리가 쓰는 태그 + 이 환경의 최근 3개만 남긴다
KEEP="$(getv "${E}_TAG_BLUE") $(getv "${E}_TAG_GREEN")"
docker images "$IMG" --format '{{.Tag}} {{.CreatedAt}}' | grep "^$ENVN-" | sort -k2,3 -r | awk 'NR>3{print $1}' \
  | while read -r t; do [[ " $KEEP " == *" $t "* ]] || docker rmi "$IMG:$t" >/dev/null 2>&1 || true; done
log "live: $NC = $IMG:$TAG"
echo "live: $NC = $IMG:$TAG"
